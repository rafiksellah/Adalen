{% extends 'admin/base.html.twig' %}

{% block title %}Animateurs - Admin Adalen{% endblock %}

{% block page_title %}Gestion des Animateurs{% endblock %}

{% block body %}
<div class="animator-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0">Liste des animateurs ({{ total }})</h2>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_admin_animator_export', { q: searchQuery|default(''), active: activeFilter|default('all') }) }}" class="btn btn-success" title="Export selon recherche et filtre statut.">
                <i class="fas fa-file-excel me-1"></i> Exporter Excel
            </a>
            <a href="{{ path('app_admin_animator_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>
                Nouvel animateur
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_admin_animator_index') }}" class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label for="anim-q" class="form-label mb-1">Recherche</label>
                    <input type="search" id="anim-q" name="q" class="form-control" value="{{ searchQuery|default('') }}" placeholder="Nom, titre, catégorie…" autocomplete="off">
                </div>
                <div class="col-md-4 col-lg-3">
                    <label for="anim-active" class="form-label mb-1">Statut</label>
                    <select id="anim-active" name="active" class="form-select">
                        <option value="all" {{ activeFilter|default('all') == 'all' ? 'selected' : '' }}>Tous</option>
                        <option value="1" {{ activeFilter|default('all') == '1' ? 'selected' : '' }}>Actifs</option>
                        <option value="0" {{ activeFilter|default('all') == '0' ? 'selected' : '' }}>Inactifs</option>
                    </select>
                </div>
                <div class="col-md-12 col-lg-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Filtrer</button>
                    <a href="{{ path('app_admin_animator_index') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    {% if animators|length > 0 %}
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Titre</th>
                            <th>Catégorie</th>
                            <th>Statut</th>
                            <th>Date création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for animator in animators %}
                        <tr>
                            <td>#{{ animator.id }}</td>
                            <td><strong>{{ animator.name }}</strong></td>
                            <td>{{ animator.title ?? '-' }}</td>
                            <td>
                                {% if animator.category %}
                                    <span class="badge bg-info">{{ animator.category }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if animator.isActive %}
                                    <span class="badge bg-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactif</span>
                                {% endif %}
                            </td>
                            <td>{{ animator.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_admin_animator_show', {id: animator.id}) }}" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_admin_animator_edit', {id: animator.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_animator_delete', {id: animator.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animateur ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animator.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% include 'admin/_pagination.html.twig' %}
    {% else %}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted">{% if searchQuery|default('')|trim != '' or activeFilter|default('all') != 'all' %}Aucun résultat pour ces critères.{% else %}Aucun animateur enregistré{% endif %}</p>
            <a href="{{ path('app_admin_animator_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>
                Créer le premier animateur
            </a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
